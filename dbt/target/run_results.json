d": true, "compiled_code": "with base as (\n    select\n        date_trunc('month', data_ref)::date as mes,\n        ln(1 + ipca_mensal_pct / 100) as ln_ipca\n    from \"prism\".\"analytics_staging\".\"stg_ipca_mensal\"\n),\nacum as (\n    select\n        mes,\n        sum(ln_ipca) over (order by mes rows between 11 preceding and current row) as soma_ln,\n        count(*) over (order by mes rows between 11 preceding and current row) as n\n    from base\n)\nselect mes, (exp(soma_ln) - 1) * 100 as ipca_12m_pct\nfrom acum\nwhere n = 12", "relation_name": "\"prism\".\"analytics_intermediate\".\"int_ipca_12m\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-17T20:12:01.315059Z", "completed_at": "2026-11-17T20:12:01.319348Z"}, {"name": "execute", "started_at": "2026-11-17T20:12:01.319733Z", "completed_at": "2026-11-17T20:12:01.352042Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.044264793395996094, "adapter_response": {"_message": "CREATE VIEW", "code": "CREATE VIEW", "rows_affected": -1}, "message": "CREATE VIEW", "failures": null, "unique_id": "model.prism.int_pib_crescimento", "compiled": true, "compiled_code": "select\n    data_ref as mes,\n    (pib_12m_rs_mi / lag(pib_12m_rs_mi, 12) over (order by data_ref) - 1) * 100\n        as cresc_pib_nominal_pct\nfrom \"prism\".\"analytics_staging\".\"stg_pib_12m\"", "relation_name": "\"prism\".\"analytics_intermediate\".\"int_pib_crescimento\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-17T20:12:01.350260Z", "completed_at": "2026-11-17T20:12:01.354419Z"}, {"name": "execute", "started_at": "2026-11-17T20:12:01.355992Z", "completed_at": "2026-11-17T20:12:01.373666Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.024314403533935547, "adapter_response": {"_message": "CREATE VIEW", "code": "CREATE VIEW", "rows_affected": -1}, "message": "CREATE VIE